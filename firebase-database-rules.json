{
  "rules": {
    ".read":  "auth != null",
    ".write": "auth != null",

    "state": {
      ".read":  "auth != null",
      ".write": "auth != null"
    },
    "history": {
      ".read": "auth != null",
      "$pushId": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['ts','user','desc'])"
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    }
  }
}
